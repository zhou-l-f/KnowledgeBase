# ============================================================
# 后端环境变量模板
# 用法：复制本文件为 backend/.env，按下方说明填写真实值
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# 注意：.env 已在 .gitignore 中忽略，请勿提交真实密钥
# ============================================================

# ---------- JWT 配置 ----------
# 签名密钥：请生成一段足够随机的字符串替换（不要沿用示例值）
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
# 令牌有效期（分钟），默认 24 小时
JWT_EXPIRE_MINUTES=1440

# ---------- 预置用户 ----------
# JSON 数组，password_hash 为 pbkdf2_sha256 哈希
# 生成哈希：在 backend 目录执行
#   python -c "from src.auth.service import hash_password; print(hash_password('你的密码'))"
# 首个初始化的管理员用于登录系统，示例（请替换为自己的哈希）：
USERS=[{"user_id": "admin", "password_hash": "pbkdf2_sha256$600000$<salt>$<hash>"}]

# ---------- DeepSeek 大模型 ----------
# 在 https://platform.deepseek.com 申请 API Key 后填入
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 向量化模型 ----------
# 可填模型名（首次运行自动从 HuggingFace 下载，国内可设 HF_ENDPOINT=https://hf-mirror.com）
# 或填已下载好的本地目录绝对路径（推荐，避免联网）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 检索与重排（可选，以下为默认值，可按需覆盖）----------
# 每次问答喂给 LLM 的片段数
# RETRIEVAL_K=2
# 是否对查询加 bge 官方指令前缀
# QUERY_USE_INSTRUCTION=false
# 是否开启交叉编码器重排
# RERANK_ENABLED=true
# 重排模型路径（默认指向 backend/models/bge-reranker-base）
# RERANK_MODEL=backend/models/bge-reranker-base
# 重排前的向量召回候选数
# RERANK_RECALL_K=10

# ---------- 存储路径（可选，默认见 src/config.py 与各模块 config.py）----------
# APP_DB_PATH=backend/data/app.db
# CHROMA_DIR=backend/data/chroma
# MEDIA_ROOT=backend/data/media